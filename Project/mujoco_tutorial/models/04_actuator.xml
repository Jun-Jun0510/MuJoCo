<?xml version="1.0" ?>
<!--
  04_actuator.xml
  Section 4 (Actuators) 用モデル: 重力下の水平アーム。
  構成:
    - 支点 (z=0.5 に固定)
    - アーム: hinge joint (Y 軸回り, 初期 θ=0 → 水平)
    - 先端錘: mass=1.0 kg, L=0.3 m
  アクチュエータは Python 側で XML を書き換えて 3 タイプ比較する。
  ここでは最もシンプルな motor タイプのみ定義。
-->
<mujoco model="actuator_demo">
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="90" elevation="-10"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 -1 2" dir="0 1 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <body name="pivot" pos="0 0 0.5">
      <geom type="box" size="0.02 0.02 0.02" rgba="0.3 0.3 0.3 1"
            contype="0" conaffinity="0"/>

      <body name="arm">
        <joint name="hinge" type="hinge" axis="0 1 0" damping="0.01"/>
        <geom name="shaft" type="capsule" fromto="0 0 0 0.3 0 0"
              size="0.015" rgba="0.4 0.6 0.8 1" mass="0.05"
              contype="0" conaffinity="0"/>
        <body name="tip" pos="0.3 0 0">
          <geom name="tip_mass" type="sphere" size="0.03" rgba="0.9 0.4 0.2 1"
                mass="1.0" contype="0" conaffinity="0"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="torque" joint="hinge" gear="1.0"
           ctrllimited="true" ctrlrange="-10 10"/>
  </actuator>
</mujoco>
